# ==============================================================================
# VERCEL ENVIRONMENT VARIABLES (ONLY SUPABASE REQUIRED)
# Add these variables in Vercel -> Project Settings -> Environment Variables
# ==============================================================================

# 1. Supabase Project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Service Role Key (Project Settings -> API -> service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Supabase PostgreSQL Connection String (Optional, enables auto-table creation)
# Project Settings -> Database -> Connection string (Transaction Pooler URI)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres